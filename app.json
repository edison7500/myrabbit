{
  "expo": {
    "name": "MyRabbit",
    "slug": "myrabbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/myrabbit-logo.png",
    "scheme": "myrabbit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/myrabbit-logo.png",
      "bundleIdentifier": "im.jiaxin.myrabbit",
      "appleTeamId": "U644HLL3MX"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#212121",
        "foregroundImage": "./assets/images/myrabbit-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/myrabbit-logo.png"
    },
    "plugins": [
      "./plugins/with-ios-script-sandboxing",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "dark": {
            "backgroundColor": "#212121"
          },
          "image": "./assets/images/myrabbit-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
