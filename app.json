{
  "expo": {
    "name": "MyRabbit",
    "slug": "myrabbit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/myrabbit-logo.png",
    "scheme": "myrabbit",
    "updates": {
      "enabled": false
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/myrabbit-logo.png",
      "bundleIdentifier": "im.jiaxin.myrabbit",
      "appleTeamId": "U644HLL3MX",
      "buildNumber": "1"
    },
    "android": {
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#212121",
        "foregroundImage": "./assets/images/myrabbit-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "im.jiaxin.myrabbit"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/myrabbit-logo.png"
    },
    "plugins": [
      "./plugins/with-ios-script-sandboxing",
      "./plugins/with-ios-widgets",
      "./plugins/with-android-release-signing",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "dark": {
            "backgroundColor": "#212121"
          },
          "image": "./assets/images/myrabbit-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
